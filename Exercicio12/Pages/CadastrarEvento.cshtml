@page
@model CadastrarEventoModel
@{
    ViewData["Title"] = "Cadastrar evento";
}

<h1 class="mb-4">Cadastrar evento</h1>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert alert-success">@Model.Mensagem</div>
}

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Evento.Titulo" class="form-label"></label>
                <input asp-for="Evento.Titulo" class="form-control" placeholder="Ex.: Workshop de C#" />
                <span asp-validation-for="Evento.Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Evento.Data" class="form-label"></label>
                <input asp-for="Evento.Data" type="datetime-local" class="form-control" />
                <span asp-validation-for="Evento.Data" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Evento.Local" class="form-label"></label>
                <input asp-for="Evento.Local" class="form-control" placeholder="Ex.: Auditório principal" />
                <span asp-validation-for="Evento.Local" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </form>
    </div>

    <div class="col-md-6 offset-md-1 mt-4 mt-md-0">
        <h2 class="h5">Eventos cadastrados</h2>

        @if (Model.Eventos.Count == 0)
        {
            <p class="text-muted">Nenhum evento cadastrado ainda.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Data</th>
                        <th>Local</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evento in Model.Eventos)
                    {
                        <tr>
                            <td>@evento.Titulo</td>
                            <td>@evento.Data?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@evento.Local</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
